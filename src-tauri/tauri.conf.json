{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Key Overlay",
  "version": "0.1.0",
  "identifier": "com.keyoverlay.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "editor",
        "title": "Key Overlay — Editor",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "resizable": true,
        "fullscreen": false,
        "skipTaskbar": false,
        "shadow": true,
        "dragDropEnabled": false,
        "visible": true,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Key Overlay",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "fullscreen": false,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
